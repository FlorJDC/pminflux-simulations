# --- agent-team (agent-team-template) ---
# agent-team job data is local state (delete these lines to version it)
jobs/*
!jobs/.gitkeep
agent-team/policy.json
__pycache__/
# --- /agent-team ---
__pycache__/
*.pyc

# review/verify scratch clones and virtualenvs (large, reproducible)
equipo/*/work/review/*/clone/
equipo/*/work/review/*/venv*/
equipo/*/work/**/venv*/
*.egg-info/
build/
